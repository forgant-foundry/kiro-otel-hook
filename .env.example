# Copy to .env (or export in your shell / kiro-cli agent env) before running kiro-cli
# in a project that has this hook installed.

# Base OTLP endpoint the hook exports to. In the validation docker-compose stack this
# is the otel-collector, not MLflow directly -- the collector fans traces out to MLflow
# and metrics out to Prometheus.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Identifies this tool's telemetry in traces/metrics.
OTEL_SERVICE_NAME=kiro-cli

# Experiment name used only for the human-readable span/metric attribute; the MLflow
# experiment that traces actually land in is selected by the otel-collector's
# x-mlflow-experiment-id header (see docker/otel-collector-config.yaml).
KIRO_MLFLOW_EXPERIMENT_NAME=kiro-cli

# Uncomment to silence hook diagnostics on stderr.
# KIRO_MLFLOW_HOOK_LOG_LEVEL=WARNING
