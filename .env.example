# Copy to .env (or export in your shell / kiro-cli agent env / CI variables) before
# running kiro-cli in a workspace that has this hook installed.

# Base OTLP endpoint the hook exports to. In the validation docker-compose stack this
# is the otel-collector, not MLflow directly -- the collector fans traces out to MLflow,
# metrics to Prometheus, and logs to Loki.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# To send traces straight to an MLflow server with no collector, use these instead
# of OTEL_EXPORTER_OTLP_ENDPOINT above (MLflow accepts traces only):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:5001/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-mlflow-experiment-id=0
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none

# Identifies this tool's telemetry in traces/metrics/logs.
OTEL_SERVICE_NAME=kiro-cli

# How much agent activity is captured: off | metadata (default) | full.
#   off      -- hook event metadata (ids, timing, tool name) and CI context only
#   metadata -- plus GenAI/MLflow span framing; still no prompt/response/tool content
#   full     -- plus payload content (tool inputs/outputs, prompts, file contents).
# WARNING: `full` can carry source code, secrets, or PII into your telemetry backend.
# Keep the default on shared machines and CI runners.
KIRO_OTEL_GENAI_DETAIL=metadata

# Experiment name used only for the human-readable span/metric attribute; the MLflow
# experiment that traces actually land in is selected by the otel-collector's
# x-mlflow-experiment-id header (see docker/otel-collector-config.yaml).
KIRO_MLFLOW_EXPERIMENT_NAME=kiro-cli

# Uncomment to silence hook diagnostics on stderr.
# KIRO_MLFLOW_HOOK_LOG_LEVEL=WARNING
